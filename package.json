{
  "name": "digital-platform",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e",
    "db:migrate": "bash scripts/migrate.sh",
    "db:check": "bash scripts/db-check.sh",
    "verify:foundation": "bash scripts/verify-foundation.sh",
    "security:audit": "bash scripts/security-audit.sh",
    "verify:preclaude": "pnpm security:audit && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e",
    "mobile:typecheck": "pnpm --dir apps/mobile typecheck",
    "verify:contracts": "bash scripts/verify-contracts.sh",
    "verify:observability": "bash scripts/verify-observability.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/kufam": "5.3.0",
    "@fontsource/lalezar": "5.3.0",
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "^0.44.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.16.0 <23",
    "pnpm": ">=10.15.0 <11"
  }
}
