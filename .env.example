NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_platform
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=dp_session
SESSION_TTL_SECONDS=2592000
TRUST_PROXY=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000

SECRETS_MASTER_KEY=replace-with-a-32-byte-or-strong-random-secret

# Dynamic pricing / FX
PRICING_CRON_SECRET=replace-with-long-random-secret
FX_PROVIDER_NAME=your-fx-provider
FX_PROVIDER_URL=https://replace-with-your-fx-provider.example/rate
FX_PROVIDER_API_KEY=

FX_PROVIDER_NAME=configured-fx-provider
FX_PROVIDER_URL=https://example.invalid/rate
# Optional: Bearer credential for the configured FX provider.
FX_PROVIDER_API_KEY=
