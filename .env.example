# ─────────────────────────────────────────────────────────────────
# Digital Platform — Environment Variables
#
# Copy this file to .env.local for local development.
# Never commit real secrets to source control.
# All vars without a default comment are REQUIRED in production.
# ─────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────
# Node environment: development | test | production (REQUIRED)
NODE_ENV=development

# Publicly visible base URL of this deployment (REQUIRED).
# Used for canonical links, OAuth callbacks, webhook URLs, and CSP.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection string (REQUIRED).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_platform

# Maximum number of DB connections in the pool (optional, default 10).
DB_POOL_MAX=10

# Statement-level timeout in milliseconds (optional, default 15000).
# Guards against runaway queries.
DB_STATEMENT_TIMEOUT_MS=15000

# Query-level timeout in milliseconds (optional, default 20000).
# Applied as a socket-level safeguard in the PG client.
DB_QUERY_TIMEOUT_MS=20000

# ── Redis / Rate limiting ─────────────────────────────────────────
# Redis connection string used for distributed rate limiting (REQUIRED in production).
# If absent the rate limiter falls back to in-memory counters (unsafe for multi-instance).
REDIS_URL=redis://localhost:6379

# ── Sessions ─────────────────────────────────────────────────────
# Name of the HTTP-only session cookie.
# In production this MUST be "__Host-dp_session" for __Host- cookie security.
# In development "dp_session" is used to allow non-HTTPS.
SESSION_COOKIE_NAME=dp_session

# Sliding idle expiry: a session unused this long ends (default 604800 = 7 days).
SESSION_IDLE_TTL_SECONDS=604800
# Absolute maximum session age regardless of activity (default 2592000 = 30 days).
# Applies to web and app sessions. SESSION_TTL_SECONDS is the legacy name for this cap.
SESSION_ABSOLUTE_TTL_SECONDS=2592000

# ── Reverse-proxy trust ──────────────────────────────────────────
# Set to "true" only when a trusted reverse proxy forwards client IPs
# via X-Forwarded-For. Never set this to true unless you control the proxy.
# Default: false
TRUST_PROXY=false

# ── Account lockout ───────────────────────────────────────────────
# Max consecutive login failures before an account is temporarily locked.
LOGIN_MAX_FAILURES=5

# Lock duration in seconds after MAX_FAILURES is reached (default 900 = 15 min).
LOGIN_LOCK_SECONDS=900

# ── Secrets encryption ───────────────────────────────────────────
# Master key for AES-GCM envelope encryption of provider credentials and
# other secrets stored in the DB. Generate with: openssl rand -hex 32
# REQUIRED — must be at least 32 bytes of high entropy.
SECRETS_MASTER_KEY=replace-with-a-32-byte-or-strong-random-secret

# ── SMS (Melipayamak) ────────────────────────────────────────────
# Preferred: store these in the DB with saveSmsSettings() (API key encrypted with
# SECRETS_MASTER_KEY). The env vars below are only a fallback.
# SMS_PROVIDER: melipayamak | console | none. "console" logs codes and is refused in
# production unless SMS_CONSOLE_LOCAL_ONLY=true AND NEXT_PUBLIC_SITE_URL is a loopback host.
SMS_PROVIDER=console
SMS_CONSOLE_LOCAL_ONLY=false
# Console API key from the Melipayamak panel (never commit a real key).
MELIPAYAMAK_API_KEY=
# Pattern (BodyId) numbers of the approved shared-line patterns.
MELIPAYAMAK_PATTERN_OTP=
MELIPAYAMAK_PATTERN_ORDER_REGISTERED=
MELIPAYAMAK_PATTERN_ORDER_COMPLETED=
MELIPAYAMAK_PATTERN_PAYMENT_RECEIPT=
MELIPAYAMAK_PATTERN_STATUS_REPLY=
# Inbound "status by SMS" webhook (/api/v1/sms/inbound?key=…). Disabled until enabled
# and the provider's forward format is confirmed; field names are configurable.
SMS_INBOUND_ENABLED=false
SMS_INBOUND_SECRET=
SMS_INBOUND_FROM_FIELD=from
SMS_INBOUND_TEXT_FIELD=text
SMS_INBOUND_ID_FIELD=id

# ── Google sign-in ───────────────────────────────────────────────
# Preferred: saveGoogleSettings() (secret encrypted in the DB). Hidden until configured.
# Authorized redirect URI in Google Cloud: ${NEXT_PUBLIC_SITE_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deep-link scheme the app registers (apps/mobile/app.json "scheme").
MOBILE_APP_SCHEME=digitalplatform

# ── Background queue ─────────────────────────────────────────────
# Bearer secret for /api/internal/queue/* (customer messages + SMS outbox worker).
QUEUE_CRON_SECRET=replace-with-long-random-secret

# ── Dynamic pricing / FX ─────────────────────────────────────────
# Secret used to authenticate the internal pricing cron webhook.
# Generate with: openssl rand -hex 32  (REQUIRED if using the pricing worker)
PRICING_CRON_SECRET=replace-with-long-random-secret

# Name identifier for the configured FX rate provider (REQUIRED for FX features).
FX_PROVIDER_NAME=your-fx-provider

# Base URL of the FX rate provider API endpoint (REQUIRED for FX features).
FX_PROVIDER_URL=https://replace-with-your-fx-provider.example/rate

# Optional Bearer token / API key for the FX provider.
FX_PROVIDER_API_KEY=
